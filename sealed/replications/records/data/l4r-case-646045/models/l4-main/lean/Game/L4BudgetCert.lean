def blookup (s : BSt) : Option Nat :=
  if s.1.x < 64 then ((bbucket s.1.x).find? (fun p => p.1 == s)).map (·.2) else none

def okB (p : BSt × Nat) : Bool :=
  acts.all fun a =>
    match stepB p.1 a with
    | none => decide (cap p.1.2 < p.2 + bcost a)
