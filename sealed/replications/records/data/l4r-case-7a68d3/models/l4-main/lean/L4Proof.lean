theorem checkTL_spec {t l : Nat} (h : checkTL t l = true) :
    ∀ big f box item, okB ⟨t, l, big, f, box, item⟩ = true := by
  intro big f box item
  simp only [checkTL, bools, dirs, List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true] at h
  cases big <;> cases f <;> cases box <;> cases item <;> simp_all

theorem okB_of (b : Blk) (ht : b.t < 40) (hl : b.l < 64) : okB b = true := by
  have h := checkTL_spec (rows_all b.t ht b.l hl) b.big b.face b.box b.item
  cases b; exact h

/-- the block actions the model ranges over: placement choice q < 4 -/
def bactOk : BAct → Prop
  | .sz _ q => q < 4
  | _ => True

theorem mem_allActs : ∀ a, bactOk a → a ∈ allActs := by
  intro a ha
  cases a with
  | mv d tu e h => cases d <;> cases tu <;> cases e <;> cases h <;> decide
  | sz e q =>
    simp only [bactOk] at ha
    have : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 := by omega
    rcases this with h | h | h | h <;> subst h <;> cases e <;> decide
  | beam e => cases e <;> decide

theorem okRes_of (b : Blk) (hf : fitsB b = true) (ht : b.t < 40) (hl : b.l < 64) (a : BAct)
    (ha : bactOk a) : okRes b a = true := by
  have h := okB_of b ht hl
  have ht' : Nat.blt b.t 40 = true := Nat.blt_eq.mpr ht
  have hl' : Nat.blt b.l 64 = true := Nat.blt_eq.mpr hl
  simp only [okB, hf, ht', hl', Bool.and_true, Bool.not_true, Bool.false_or] at h
  exact List.all_eq_true.mp h a (mem_allActs a ha)

theorem cons_go {b b' : Blk} {a : BAct} (hb : bstep 0 b a = .go b') (h : okRes b a = true) :
    fitsB b' = true ∧ b'.t < 40 ∧ b'.l < 64 ∧ phi b ≤ cost a + phi b' ∧
      (b'.item = true → b.item = true) := by
  simp only [okRes, hb, Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq, Bool.or_eq_true,
    Bool.not_eq_true'] at h
  obtain ⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩ := h
  refine ⟨h1, h2, h3, h4, ?_⟩
  intro hi
  cases h5 with
  | inl h => rw [hi] at h; cases h
  | inr h => exact h

theorem cons_win {b : Blk} {a : BAct} {it : Bool} (hb : bstep 0 b a = .win it)
    (h : okRes b a = true) : phi b ≤ cost a + (if it then 10 else 0) ∧ it = b.item := by
  simp only [okRes, hb, Bool.and_eq_true, Nat.ble_eq, beq_iff_eq] at h
  exact h

theorem credit_ok (m c : Nat) (hm : m < 512) (hc : c < 9) :
    credit (m ^^^ (1 <<< c)) ≤ credit m + 1 ∧ (m ^^^ (1 <<< c)) < 512 ∧
    ((m ^^^ (1 <<< c)) = 170 → 3 ≤ credit m) ∧ ((m ^^^ (1 <<< c)) = 146 → 2 ≤ credit m) := by
  have h := creditOK_all m c hm hc
  simp only [creditOK, Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq, Bool.or_eq_true,
    Bool.not_eq_true', beq_eq_false_iff_ne] at h
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := h
  refine ⟨h1, h2, fun e => ?_, fun e => ?_⟩
  · cases h3 with
    | inl h => exact absurd e h
    | inr h => exact h
  · cases h4 with
    | inl h => exact absurd e h
    | inr h => exact h

theorem credit_zero : credit 0 = 0 := by decide

def phiF (x : Full) : Nat := if x.won then (if x.b.item then 10 else 0) else phi x.b

/-- The invariant: the potential (lower bound on macro-cost to a win, +10 if the win would leave the
    item uneaten) exceeds the remaining budget 18 - used, plus grid progress, plus the item's refund. -/
def Inv (x : Full) : Prop :=
  x.used ≤ 20 ∧ x.mask < 512 ∧
  (x.won = false → fitsB x.b = true ∧ x.b.t < 40 ∧ x.b.l < 64) ∧
  (x.won = true → x.used ≤ 18) ∧
  18 + credit x.mask + (if x.b.item then 10 else 0) < phiF x + x.used

theorem inv_not_goal (x : Full) (h : Inv x) : goal x = false := by
  obtain ⟨-, -, -, hw18, hp⟩ := h
  cases hw : x.won
  · simp [goal, hw]
  · exfalso
    have hu := hw18 hw
    simp only [phiF, hw, ite_true] at hp
    cases hi : x.b.item <;> simp [hi] at hp <;> omega

theorem arith (i i' : Bool) (hit : i' = true → i = true) (u c cr crm P P' k : Nat)
    (hu : u ≤ 18) (hc : c ≤ 2) (hcr : k + crm ≤ c + cr)
    (hp : 18 + cr + (if i = true then 10 else 0) < P + u) (hφ : P ≤ k + P') :
    (if (i && !i') = true then u + c - 10 else u + c) ≤ 20 ∧
    18 + crm + (if i' = true then 10 else 0) <
      P' + (if (i && !i') = true then u + c - 10 else u + c) := by
  cases i <;> cases i' <;> simp at hit hp ⊢ <;> omega

theorem arith_win (i : Bool) (u c cr crm P k : Nat) (hcr : k + crm ≤ c + cr) (hb : u + c ≤ 18)
    (hp : 18 + cr + (if i = true then 10 else 0) < P + u)
    (hφ : P ≤ k + (if i = true then 10 else 0)) : False := by
  cases i <;> simp at hp hφ <;> omega

theorem keep_apply (x x' : Full) (ba : BAct) (hba : bactOk ba) (c m : Nat) (hu : x.used ≤ 18)
    (hfit : fitsB x.b = true) (ht : x.b.t < 40) (hl : x.b.l < 64) (hm : m < 512) (hc : c ≤ 2)
    (hcr : cost ba + credit m ≤ c + credit x.mask)
    (hp : 18 + credit x.mask + (if x.b.item = true then 10 else 0) < phi x.b + x.used)
    (hs : applyR 18 x (bstep 0 x.b ba) c m = .ok x') : Inv x' := by
  have hok := okRes_of x.b hfit ht hl ba hba
  cases hb : bstep 0 x.b ba with
  | go b' =>
    rw [hb] at hs
    simp only [applyR, Res.ok.injEq] at hs
    subst hs
    obtain ⟨f', t', l', hφ, hit⟩ := cons_go hb hok
    have A := arith x.b.item b'.item hit x.used c (credit x.mask) (credit m) (phi x.b) (phi b')
      (cost ba) hu hc hcr hp hφ
    exact ⟨A.1, hm, fun _ => ⟨f', t', l'⟩, (fun h => Bool.noConfusion h), A.2⟩
  | win it =>
    rw [hb] at hs
    simp only [applyR] at hs
    by_cases hB : x.used + c ≤ 18
    · rw [if_pos hB] at hs
      exfalso
      obtain ⟨hφ, hit⟩ := cons_win hb hok
      subst hit
      exact arith_win x.b.item x.used c (credit x.mask) (credit m) (phi x.b) (cost ba) hcr hB hp hφ
    · rw [if_neg hB] at hs; cases hs

theorem step_mv (x : Full) (d : Dir) (tu e h : Bool) : step x (.mv d tu e h) =
    (if x.won = true then .ok x else if 18 < x.used then .reset else
      applyR 18 x (bstep 0 x.b (.mv d tu e h)) 1 x.mask) := rfl

theorem step_off (x : Full) : step x .off =
    (if x.won = true then .ok x else if 18 < x.used then .reset else .ok x) := rfl

theorem step_click (x : Full) (c : Nat) (e : Bool) (q : Nat) : step x (.click c e q) =
    (if x.won = true then .ok x else if 18 < x.used then .reset else
      if x.mask ^^^ (1 <<< c) = fMask then applyR 18 x (bstep 0 x.b (.sz e q)) 2 0
      else if x.mask ^^^ (1 <<< c) = sixMask then applyR 18 x (bstep 0 x.b (.beam e)) 2 0
      else .ok { x with mask := x.mask ^^^ (1 <<< c), used := x.used + 1 }) := rfl

theorem inv_keep (x x' : Full) (a : Act) (hla : legal a) (hI : Inv x)
    (hs : step x a = .ok x') : Inv x' := by
  have hng := inv_not_goal x hI
  simp only [goal] at hng
  obtain ⟨hu, hm, hf, hw18, hp⟩ := hI
  obtain ⟨hfit, ht, hl⟩ := hf hng
  have hphi : phiF x = phi x.b := by simp [phiF, hng]
  rw [hphi] at hp
  have hnw : ¬ (x.won = true) := by rw [hng]; exact Bool.false_ne_true
  cases a with
  | off =>
    rw [step_off, if_neg hnw] at hs
    by_cases hB : 18 < x.used
    · rw [if_pos hB] at hs; cases hs
    · rw [if_neg hB] at hs; cases hs
      exact ⟨hu, hm, hf, hw18, by rw [hphi]; exact hp⟩
  | mv d turn eat half =>
    rw [step_mv, if_neg hnw] at hs
    by_cases hB : 18 < x.used
    · rw [if_pos hB] at hs; cases hs
    · rw [if_neg hB] at hs
      exact keep_apply x x' (BAct.mv d turn eat half) trivial 1 x.mask (by omega) hfit ht hl hm (by omega)
        (by simp [cost]) hp hs
  | click c eat q =>
    simp only [legal] at hla
    obtain ⟨hc9, hq4⟩ := hla
    obtain ⟨h1, h2, h3, h4⟩ := credit_ok x.mask c hm hc9
    rw [step_click, if_neg hnw] at hs
    by_cases hB : 18 < x.used
    · rw [if_pos hB] at hs; cases hs
    · rw [if_neg hB] at hs
      have hu18 : x.used ≤ 18 := by omega
      by_cases e1 : (x.mask ^^^ (1 <<< c)) = fMask
      · rw [if_pos e1] at hs
        have := h3 e1
        exact keep_apply x x' (BAct.sz eat q) (show bactOk (BAct.sz eat q) from hq4) 2 0 hu18 hfit ht hl (by decide) (by omega)
          (by simp only [cost, credit_zero]; omega) hp hs
      · rw [if_neg e1] at hs
        by_cases e2 : (x.mask ^^^ (1 <<< c)) = sixMask
        · rw [if_pos e2] at hs
          have := h4 e2
          exact keep_apply x x' (BAct.beam eat) trivial 2 0 hu18 hfit ht hl (by decide) (by omega)
            (by simp only [cost, credit_zero]; omega) hp hs
        · rw [if_neg e2] at hs; cases hs
          have e : phiF { x with mask := x.mask ^^^ (1 <<< c), used := x.used + 1 } = phi x.b := by
            simp only [phiF, hng, Bool.false_eq_true, ite_false]
          have hw' : ∀ h : ({ x with mask := x.mask ^^^ (1 <<< c), used := x.used + 1 } : Full).won = true,
              ({ x with mask := x.mask ^^^ (1 <<< c), used := x.used + 1 } : Full).used ≤ 18 := by
            intro h; simp only at h; rw [hng] at h; exact Bool.noConfusion h
          refine ⟨by simp only; omega, h2, fun _ => ⟨hfit, ht, hl⟩, hw', ?_⟩
          rw [e]; simp only; omega

theorem phi_start : phi start.b = 29 := by decide +kernel
theorem fits_start : fitsB start.b = true := by decide +kernel

theorem inv_start : Inv start := by
  refine ⟨by decide, by decide, fun _ => ⟨fits_start, by decide, by decide⟩, (fun h => Bool.noConfusion h), ?_⟩
  have h := phi_start
  show 18 + credit 0 + (if true = true then 10 else 0) < phiF start + 0
  have e : phiF start = phi start.b := rfl
  rw [e, h, credit_zero]; decide

/-- **Main theorem.** Model M4 v2 with budget 18 and shrink-facing-down placement `qD`.
    Under hypothesis H_shrinkD (`qD = 0`: a shrink while facing down keeps the top-left quadrant,
    as observed in all 4 recorded shrinks facing U/R/L), no list of legal actions from the L4 reset
    position ever passes through a won state. -/
theorem l4_unwinnable (qD : Nat) (H_shrinkD : qD = 0) :
    ∀ as : List Act, (∀ a ∈ as, legal a) → everGoal (stepB qD 18) goal start as = false := by
  subst H_shrinkD
  intro as h
  exact goal_never_holds_of_conserved step goal legal Inv
    (fun s s' a hla hp hs => inv_keep s s' a hla hp hs) inv_not_goal as start inv_start h

/-! ## Non-vacuity: two relaxations, each of which makes the same model winnable. -/

def fClicks (eat : Bool) (q : Nat := 0) : List Act :=
  [.click 1 false 0, .click 3 false 0, .click 5 false 0, .click 7 eat q]
def beamClicks (eat : Bool) : List Act := [.click 1 false 0, .click 4 false 0, .click 7 eat 0]
def mvA (d : Dir) (eat : Bool := false) : Act := .mv d false eat false

/-- the line played in attempt 2 (19 ticks) -/
def witness19 : List Act :=
  [mvA .D, mvA .D, mvA .L, mvA .L, mvA .L] ++ fClicks false ++ [mvA .D] ++ fClicks true ++
  [mvA .R, mvA .R, mvA .U] ++ beamClicks false ++ [mvA .R, mvA .R, mvA .R, mvA .R, mvA .R, mvA .R]

/-- a line that wins if a shrink facing down keeps the bottom-left quadrant (qD = 2) -/
def witnessQD2 : List Act :=
  [mvA .D, mvA .D] ++ fClicks false ++ fClicks false ++ [mvA .L, mvA .L, mvA .L true, mvA .R, mvA .R, mvA .U] ++
  beamClicks false ++ [mvA .R, mvA .R, mvA .R, mvA .R, mvA .R, mvA .R]

/-- relaxation 1: budget 18 -> 19 (one tick) -/
theorem relaxed_budget19_wins : everGoal (stepB 0 19) goal start witness19 = true := by decide +kernel
theorem witness19_fails_at_18 : everGoal (stepB 0 18) goal start witness19 = false := by decide +kernel
/-- relaxation 2: drop H_shrinkD (qD = 2), budget 18 -/
theorem relaxed_shrinkD_wins : everGoal (stepB 2 18) goal start witnessQD2 = true := by decide +kernel

