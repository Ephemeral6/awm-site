/-
# L4Model — abstract model of level 4 (attempt 1, AMENDED after attempt 2) and the budget lower bound.

Attempt-2 amendments (everything else unchanged from attempt 1):
* cost: unit model fitted on all four levels (work/fit_budget.py): every accepted game action = 1 unit,
  every pattern completion +1 unit. So `resize` = 4 clicks + 1 = 5, `fire` = 3 clicks + 1 = 4, move = 1.
* fireRule: the shot is a projectile in lattice column `s.j` (2x2: its column; 4x4: its LEFT column),
  moving up; it opens the door iff it reaches a box cell before any other blocked cell. (Attempt 1 used a
  "range <= 11 rows" rule, refuted: a 2x2 shot flew 3 steps over floor and died at a wall.)
* door blocks a 2x2: was an assumption, now observed (tid e78e11aeb025a492); no definition change.

Board: the observed level-4 start frame folded onto a lattice of 2x2-pixel cells
(lattice cell (i,j) = pixel rows 2i+1..2i+2, cols 2j+1..2j+2). A cell is Blocked (any wall 5,
door d, box 6/d, legend, panel or bar pixel), Goal (a cap pixel 9/a and no blocker) or Free.
The masks were produced by work/model_l4.py from work/l4_start.json (generated by work/gen_lean.py).

Modelling assumptions written into the definitions (LOOSER than the game wherever the game is unknown):
* Panel clicks are bundled into macro actions: `resize` costs 5 units (4 clicks, +1 completion; the
  panel starts empty and every completion empties it), `fire` costs 4 (3 clicks, +1).
  Clicks change only the panel, moves change only the player, so a completion's clicks can be moved next
  to it without changing the outcome; wasted clicks only add cost. No real play is excluded.
* `resize` may shrink into ANY quadrant and grow from ANY of the 4 placements containing the 2x2
  (game: shrink keeps top-left, observed 3 times). Looser.
* `fire` opens the door iff facing up and the projectile column (s.j) reaches a box cell before any wall
  (observed: 4x4 at cols 29-32 fails, its left half meets the wall at rows 19-20; L3 4x4 passes with the
  neck under its left half; 2x2 shot dies at the first wall). Box cells are treated as hit even when a
  lattice cell also holds wall pixels (looser).
* A move into a rectangle with a cap pixel (9 or a) and no blocker wins; growing onto the cap also wins.
* The e marker (rows 34-35, cols 23-24) is floor (observed: 4x4 covering it changed nothing).
-/
namespace L4

structure St where
  i : Nat
  j : Nat
  big : Bool
  up : Bool
  door : Bool
deriving DecidableEq, Repr

inductive Dir | up | down | left | right
deriving DecidableEq, Repr

inductive Act | move (d : Dir) | resize (q : Fin 4) | fire
deriving DecidableEq, Repr

inductive Out | win | st (s : St)
deriving DecidableEq, Repr

def blockClosed : Nat := @BC@
def blockOpen : Nat := @BO@
def goalMask : Nat := @GM@
def boxMask : Nat := @BX@

def bit (m k : Nat) : Bool := (m >>> k) % 2 == 1

def cellBlocked (door : Bool) (i j : Nat) : Bool :=
  if i < 32 && j < 32 then bit (if door then blockOpen else blockClosed) (i * 32 + j) else true

def cellGoal (i j : Nat) : Bool := i < 32 && j < 32 && bit goalMask (i * 32 + j)

def rectBlocked (door big : Bool) (i j : Nat) : Bool :=
  if big then cellBlocked door i j || cellBlocked door (i+1) j || cellBlocked door i (j+1) || cellBlocked door (i+1) (j+1)
  else cellBlocked door i j

def rectGoal (big : Bool) (i j : Nat) : Bool :=
  if big then cellGoal i j || cellGoal (i+1) j || cellGoal i (j+1) || cellGoal (i+1) (j+1)
  else cellGoal i j

/-- Rule MOVE (concepts move_by_size, face_dir, blocked_by_nonfloor, and the goal rule). -/
def moveRule (s : St) (d : Dir) : Out :=
  let k := if s.big then 2 else 1
  let up' := d == Dir.up
  let tgt : Option (Nat × Nat) := match d with
    | .up => if s.i < k then none else some (s.i - k, s.j)
    | .down => some (s.i + k, s.j)
    | .left => if s.j < k then none else some (s.i, s.j - k)
    | .right => some (s.i, s.j + k)
  match tgt with
  | none => .st { s with up := up' }
  | some (ni, nj) =>
    if rectBlocked s.door s.big ni nj then .st { s with up := up' }
    else if rectGoal s.big ni nj then .win
    else .st { s with i := ni, j := nj, up := up' }

/-- Rule RESIZE (f-pattern completion, concept complete_f_resize; anchor loosened). -/
def resizeRule (s : St) (q : Fin 4) : Out :=
  let qi := q.val / 2
  let qj := q.val % 2
  if s.big then
    (if s.i + qi < 32 && s.j + qj < 32 then .st { s with i := s.i + qi, j := s.j + qj, big := false } else .st s)
  else if s.i < qi || s.j < qj then .st s
  else if rectBlocked s.door true (s.i - qi) (s.j - qj) then .st s
  else if rectGoal true (s.i - qi) (s.j - qj) then .win
  else .st { s with i := s.i - qi, j := s.j - qj, big := true }

def cellBox (i j : Nat) : Bool := i < 32 && j < 32 && bit boxMask (i * 32 + j)

/-- The projectile scans the cells (k-1, jp), (k-2, jp), ..., (0, jp): box first -> hit, wall -> destroyed. -/
def shotHits (jp : Nat) : Nat → Bool
  | 0 => false
  | k + 1 => if cellBox k jp then true else if cellBlocked false k jp then false else shotHits jp k

/-- Rule FIRE (6-pattern completion; attempt-2 projectile rule). -/
def fireRule (s : St) : Out :=
  if s.up && !s.door && shotHits s.j s.i then .st { s with door := true } else .st s

def step (s : St) : Act → Out
  | .move d => moveRule s d
  | .resize q => resizeRule s q
  | .fire => fireRule s

def cost : Act → Nat
  | .move _ => 1
  | .resize _ => 5
  | .fire => 4

def costL : List Act → Nat
  | [] => 0
  | a :: as => cost a + costL as

def run (s : St) : List Act → Out
  | [] => .st s
  | a :: as => match step s a with
    | .win => .win
    | .st s' => run s' as

def start : St := { i := 12, j := 18, big := true, up := false, door := false }

/-! ## Certificate: cost-to-win table (found by work/model_l4.py, CHECKED here against `step`). -/

def dtab : Nat := @DT@

def key (s : St) : Nat :=
  (((s.i * 32 + s.j) * 2 + (if s.big then 1 else 0)) * 2 + (if s.up then 1 else 0)) * 2 + (if s.door then 1 else 0)

def dget (s : St) : Nat := (dtab >>> (6 * key s)) % 64

def valid (s : St) : Bool := decide (s.i < 32) && decide (s.j < 32)

def okStep (s : St) (a : Act) : Bool :=
  match step s a with
  | .win => decide (dget s ≤ cost a)
  | .st s' => valid s' && decide (dget s ≤ cost a + dget s')

def allActs : List Act :=
  [.move .up, .move .down, .move .left, .move .right, .resize 0, .resize 1, .resize 2, .resize 3, .fire]

theorem mem_allActs (a : Act) : a ∈ allActs := by
  cases a with
  | move d => cases d <;> simp [allActs]
  | resize q =>
    match q with
    | ⟨0, _⟩ => simp [allActs]
    | ⟨1, _⟩ => simp [allActs]
    | ⟨2, _⟩ => simp [allActs]
    | ⟨3, _⟩ => simp [allActs]
  | fire => simp [allActs]

def okState (s : St) : Bool := allActs.all (okStep s)

def bools : List Bool := [false, true]

def okRow (i : Nat) : Bool :=
  (List.range 32).all fun j => bools.all fun b => bools.all fun u => bools.all fun d =>
    okState { i := i, j := j, big := b, up := u, door := d }

theorem okRows_0 : ((List.range 8).map (· + 0)).all okRow = true := by decide +kernel
theorem okRows_1 : ((List.range 8).map (· + 8)).all okRow = true := by decide +kernel
theorem okRows_2 : ((List.range 8).map (· + 16)).all okRow = true := by decide +kernel
theorem okRows_3 : ((List.range 8).map (· + 24)).all okRow = true := by decide +kernel

theorem okRows_aux (lo : Nat) (h : ((List.range 8).map (· + lo)).all okRow = true)
    (k : Nat) (h1 : lo ≤ k) (h2 : k < lo + 8) : okRow k = true := by
  rw [List.all_eq_true] at h
  exact h k (List.mem_map.mpr ⟨k - lo, List.mem_range.mpr (by omega), by omega⟩)

theorem okRow_all (k : Nat) (hk : k < 32) : okRow k = true := by
  by_cases a : k < 8
  · exact okRows_aux 0 okRows_0 k (by omega) (by omega)
  by_cases b : k < 16
  · exact okRows_aux 8 okRows_1 k (by omega) (by omega)
  by_cases c : k < 24
  · exact okRows_aux 16 okRows_2 k (by omega) (by omega)
  · exact okRows_aux 24 okRows_3 k (by omega) (by omega)

theorem mem_bools (b : Bool) : b ∈ bools := by cases b <;> simp [bools]

theorem okState_of_valid (s : St) (hv : valid s = true) : okState s = true := by
  have hv' : s.i < 32 ∧ s.j < 32 := by simpa [valid] using hv
  have hr := okRow_all s.i hv'.1
  simp only [okRow, List.all_eq_true, List.mem_range] at hr
  have := hr s.j hv'.2 s.big (mem_bools _) s.up (mem_bools _) s.door (mem_bools _)
  cases s
  exact this

theorem okStep_of_valid (s : St) (hv : valid s = true) (a : Act) : okStep s a = true := by
  have h := okState_of_valid s hv
  simp only [okState, List.all_eq_true] at h
  exact h a (mem_allActs a)

/-- Every winning action list from a valid state costs at least the table value. -/
theorem win_cost_ge (as : List Act) : ∀ s, valid s = true → run s as = .win → dget s ≤ costL as := by
  induction as with
  | nil => intro s _ h; simp [run] at h
  | cons a as ih =>
    intro s hv h
    have hok := okStep_of_valid s hv a
    simp only [run] at h
    simp only [costL]
    unfold okStep at hok
    cases hs : step s a with
    | win =>
      rw [hs] at hok
      have : dget s ≤ cost a := of_decide_eq_true hok
      omega
    | st s' =>
      rw [hs] at hok h
      simp only [Bool.and_eq_true] at hok
      have h2 : dget s ≤ cost a + dget s' := of_decide_eq_true hok.2
      have h3 := ih s' hok.1 h
      omega

theorem dget_start : dget start = 23 := by decide

theorem valid_start : valid start = true := by decide

/-- In the model, no action list of total cost < 23 wins level 4 from its start state. -/
theorem l4_no_win_below_23 (as : List Act) (h : costL as < 23) : run start as ≠ .win := by
  intro hw
  have := win_cost_ge as start valid_start hw
  rw [dget_start] at this
  omega

/-- MAIN. Budget hypothesis: level-4 budget is 18 units and an action still resolves when it STARTS with
    at most 18 units used, so a completed macro sequence costs at most 18 + 2 = 20 (the last game action
    may be a completion click costing 2). -/
theorem l4_unwinnable_within_budget (as : List Act) (hbudget : costL as ≤ 20) : run start as ≠ .win :=
  l4_no_win_below_23 as (by omega)

/-! ## Non-vacuity -/

/-- Relaxing the budget from 20 to 23 (+3; minimal by `l4_no_win_below_23`) admits a winning list. -/
def witness : List Act :=
  [.move .down, .move .left, .resize 2, .move .up, .resize 1, .fire,
   .move .right, .move .right, .move .right, .move .right, .move .right, .move .right]

theorem witness_wins : run start witness = .win ∧ costL witness = 23 := by decide

/-- The closed door is a real constraint: with it open, cost 6 wins. -/
theorem open_door_cheap :
    run { start with door := true }
      [.move .down, .move .right, .move .right, .move .right, .move .right, .move .right] = .win := by decide

/-- The firing range is a real constraint: the 4x4 at the room top (gap 12, observed failure) cannot open it. -/
theorem fire_from_room_top_fails :
    step { start with i := 10, j := 14, up := true } .fire = .st { start with i := 10, j := 14, up := true } := by decide

/-- Attempt-2 observation reproduced: a 2x2 in column j=21 (cols 43-44) fires into the wall. -/
theorem fire_2x2_col43_fails :
    step { i := 13, j := 21, big := false, up := true, door := false } .fire
      = .st { i := 13, j := 21, big := false, up := true, door := false } := by decide

/-- ... while a 2x2 under the neck (j = 15) does open the door: the fire rule is not vacuous. -/
theorem fire_2x2_neck_opens :
    step { i := 10, j := 15, big := false, up := true, door := false } .fire
      = .st { i := 10, j := 15, big := false, up := true, door := true } := by decide

/-! ## Attempt 3 amendment: facing, e-marker pickup, counter with refill and cap

Changes (everything above is kept; the new step reuses `moveRule` and `fireRule`):
* slot `face : Dir` restored (attempt 1 dropped it to `up`, but the pickup rule now reads the front half);
* slot `picked : Bool` (the single e marker, lattice cells (16,11) and (17,11), is consumed once);
* rule PICKUP (observed attempt 3: 2x2 onto it refilled; attempt 1: 4x4 covering it with its front half
  elsewhere did not). Unknown which of "small size" / "front half" triggers it: the model fires on EITHER;
* rule REFILL: counter u := min 7 (u + cost - 10, floored at 0) (lower of the two fitting readings 'set to 7'
  and 'minus 10'; observed 17 -> 7);
* rule RESIZE (amended, observed anchors): shrink keeps top-left (5 observations); grow keeps the bottom row,
  extends right if free else left (2 observations); only if both are walled may it pick any free placement;
* BUDGET premise (from the fit B = 18): an action may START only while u ≤ cap; cap is a parameter of `runB`.
  A macro (pattern) is allowed to start at u ≤ cap even though its later clicks would exceed it (looser).
-/

structure St3 where
  i : Nat
  j : Nat
  big : Bool
  face : Dir
  door : Bool
  picked : Bool
deriving DecidableEq, Repr

inductive Out3 | win | st (s : St3) (newly : Bool)
deriving DecidableEq, Repr

def toSt (s : St3) : St := { i := s.i, j := s.j, big := s.big, up := s.face == Dir.up, door := s.door }

def isE (i j : Nat) : Bool := (i == 16 || i == 17) && j == 11

/-- PICKUP trigger (union of the two hypotheses). -/
def triggers (i j : Nat) (big : Bool) (face : Dir) : Bool :=
  if !big then isE i j
  else match face with
    | .up => isE i j || isE i (j+1)
    | .down => isE (i+1) j || isE (i+1) (j+1)
    | .left => isE i j || isE (i+1) j
    | .right => isE i (j+1) || isE (i+1) (j+1)

def settle3 (s : St3) (i j : Nat) (big : Bool) (face : Dir) (door : Bool) : Out3 :=
  .st { i := i, j := j, big := big, face := face, door := door, picked := s.picked || triggers i j big face }
    (!s.picked && triggers i j big face)

def growOk (door : Bool) (i j : Nat) : Bool := !rectBlocked door true i j

/-- RESIZE with the observed anchors. -/
def resize3 (s : St3) (q : Fin 4) : Out3 :=
  if s.big then
    (if q.val == 0 then settle3 s s.i s.j false s.face s.door else .st s false)
  else
    let qi := q.val / 2
    let qj := q.val % 2
    let upR := decide (1 ≤ s.i) && growOk s.door (s.i - 1) s.j
    let upL := decide (1 ≤ s.i) && decide (1 ≤ s.j) && growOk s.door (s.i - 1) (s.j - 1)
    -- attempt 4: grow extends UP and LEFT unless walled (was: right first; refuted by tid 81e5d751d32a2557)
    let allowed := if upL then qi == 1 && qj == 1 else if upR then qi == 1 && qj == 0 else true
    if !allowed || decide (s.i < qi) || decide (s.j < qj) then .st s false
    else if rectBlocked s.door true (s.i - qi) (s.j - qj) then .st s false
    else if rectGoal true (s.i - qi) (s.j - qj) then .win
    else settle3 s (s.i - qi) (s.j - qj) true s.face s.door

/-- Attempt 8: a move advances in 2-px sub-steps as far as free (observed tid ece0a2f5605e3199: a 4x4
    whose full step was walled moved one 2-px sub-step). Reaching the goal in a free (sub-)step wins. -/
def subTarget (i j : Nat) (d : Dir) (k : Nat) : Option (Nat × Nat) :=
  match d with
  | .up => if i < k then none else some (i - k, j)
  | .down => some (i + k, j)
  | .left => if j < k then none else some (i, j - k)
  | .right => some (i, j + k)

def moveSub3 (s : St3) (d : Dir) : Out3 :=
  let turn := settle3 s s.i s.j s.big d s.door
  let half : Out3 :=
    if s.big then
      match subTarget s.i s.j d 1 with
      | some (hi, hj) =>
        if !rectBlocked s.door true hi hj then
          (if rectGoal true hi hj then .win else settle3 s hi hj true d s.door)
        else turn
      | none => turn
    else turn
  match subTarget s.i s.j d (if s.big then 2 else 1) with
  | some (ni, nj) =>
    if !rectBlocked s.door s.big ni nj then
      (if rectGoal s.big ni nj then .win else settle3 s ni nj s.big d s.door)
    else half
  | none => half

def step3 (s : St3) : Act → Out3
  | .move d => moveSub3 s d
  | .resize q => resize3 s q
  | .fire => match fireRule (toSt s) with
    | .win => .win
    | .st s' => .st { s with door := s'.door } false

/-- REFILL / counter update. -/
def nu (u : Nat) (a : Act) (newly : Bool) : Nat :=
  -- attempt 4: refill = minus 10 exactly (15 -> 5 observed; 'set to 7' refuted)
  if newly then (if u + cost a ≤ 10 then 0 else u + cost a - 10) else u + cost a

/-- Run with a budget cap: an action is taken only if it starts with counter ≤ cap. -/
def runB (cap : Nat) (s : St3) (u : Nat) : List Act → Bool
  | [] => false
  | a :: as => if u > cap then false else match step3 s a with
    | .win => true
    | .st s' n => runB cap s' (nu u a n) as

def start3 : St3 := { i := 12, j := 18, big := true, face := .down, door := false, picked := false }

/-! Certificate: g s = least counter from which no win is possible (cap 17), found by work/model_l4b.py,
    checked here against `step3`. -/
def gtab : Nat := @GT@

def dirIx : Dir → Nat | .up => 0 | .down => 1 | .left => 2 | .right => 3

def key3 (s : St3) : Nat :=
  ((((s.i * 32 + s.j) * 2 + (if s.big then 1 else 0)) * 4 + dirIx s.face) * 2 + (if s.door then 1 else 0)) * 2
    + (if s.picked then 1 else 0)

def g (s : St3) : Nat := (gtab >>> (5 * key3 s)) % 32

def valid3 (s : St3) : Bool := decide (s.i < 32) && decide (s.j < 32)

/-- The action that STARTS at the last affordable unit (u = cap) is the last one (GAME_OVER after it).
    Attempt 5: a 4x4 move from 4 px short of the goal did NOT enter it (it stopped 2 px short,
    tid c20aa696def56d6b). Attempt 6: a 4x4 move with no goal involved moved its full 4 px (tid 38c8c6ceae907237),
    so the attempt-5 'half-step' reading is refuted; what is established is only: at u = cap a 4x4 move whose
    goal contact would come in its SECOND 2-px sub-step does not win. Generously, the last action still wins if
    the goal is reached within the first 2-px sub-step (`halfWin`), and a 2x2's last move (one sub-step) wins
    normally. The end position of the last action is not modelled (the game is over). -/
def halfWin (s : St3) (d : Dir) : Bool :=
  let tgt : Option (Nat × Nat) := match d with
    | .up => if s.i < 1 then none else some (s.i - 1, s.j)
    | .down => some (s.i + 1, s.j)
    | .left => if s.j < 1 then none else some (s.i, s.j - 1)
    | .right => some (s.i, s.j + 1)
  match tgt with
  | none => false
  | some (ni, nj) => !rectBlocked s.door true ni nj && rectGoal true ni nj

def isWin : Out3 → Bool | .win => true | _ => false

def lastWins (s : St3) (a : Act) : Bool :=
  match a with
  | .move d => if s.big then halfWin s d else isWin (step3 s a)
  | _ => isWin (step3 s a)

/-- Budgeted run, attempt-5 rule. -/
def runB5 (cap : Nat) (s : St3) (u : Nat) : List Act → Bool
  | [] => false
  | a :: as => if u > cap then false else if u = cap then lastWins s a else match step3 s a with
    | .win => true
    | .st s' n => runB5 cap s' (nu u a n) as

def ok3 (s : St3) (a : Act) : Bool :=
  if g s > 18 then true else
  !lastWins s a &&
  (if g s = 18 then true else
    match step3 s a with
    | .win => false
    | .st s' n => valid3 s' && decide (g s' ≤ nu (g s) a n))

def dirs : List Dir := [.up, .down, .left, .right]

def okState3 (s : St3) : Bool := allActs.all (ok3 s)

def okRow3 (i : Nat) : Bool :=
  (List.range 32).all fun j => bools.all fun b => dirs.all fun f => bools.all fun d => bools.all fun p =>
    okState3 { i := i, j := j, big := b, face := f, door := d, picked := p }

@CHUNKS@

theorem okRow3_aux (lo : Nat) (h : ((List.range 4).map (· + lo)).all okRow3 = true)
    (k : Nat) (h1 : lo ≤ k) (h2 : k < lo + 4) : okRow3 k = true := by
  rw [List.all_eq_true] at h
  exact h k (List.mem_map.mpr ⟨k - lo, List.mem_range.mpr (by omega), by omega⟩)

theorem okRow3_all (k : Nat) (hk : k < 32) : okRow3 k = true := by
@DISPATCH@

theorem mem_dirs (d : Dir) : d ∈ dirs := by cases d <;> simp [dirs]

theorem ok3_of_valid (s : St3) (hv : valid3 s = true) (a : Act) : ok3 s a = true := by
  have hv' : s.i < 32 ∧ s.j < 32 := by simpa [valid3] using hv
  have hr := okRow3_all s.i hv'.1
  simp only [okRow3, List.all_eq_true, List.mem_range] at hr
  have h := hr s.j hv'.2 s.big (mem_bools _) s.face (mem_dirs _) s.door (mem_bools _) s.picked (mem_bools _)
  have h2 : okState3 s = true := by cases s; exact h
  simp only [okState3, List.all_eq_true] at h2
  exact h2 a (mem_allActs a)

theorem nu_mono (u v : Nat) (a : Act) (n : Bool) (h : u ≤ v) : nu u a n ≤ nu v a n := by
  unfold nu
  cases n
  · simp only [Bool.false_eq_true, if_false]; omega
  · simp only [if_true]
    split <;> split <;> omega

/-- Invariant: from a valid state whose counter is at least g, no action list wins (cap 18, attempt-5 rule). -/
theorem no_win_from (as : List Act) : ∀ s u, valid3 s = true → g s ≤ u → runB5 18 s u as = false := by
  induction as with
  | nil => intro s u _ _; rfl
  | cons a as ih =>
    intro s u hv hg
    have hok := ok3_of_valid s hv a
    by_cases hu : u > 18
    · simp [runB5, hu]
    · have hgs : ¬ g s > 18 := by omega
      unfold ok3 at hok
      simp only [hgs, if_false, Bool.and_eq_true, Bool.not_eq_true'] at hok
      by_cases he : u = 18
      · simp only [runB5, hu, he, if_false, if_true]; exact hok.1
      · have hg17 : ¬ g s = 18 := by omega
        simp only [hg17, if_false] at hok
        simp only [runB5, hu, he, if_false]
        cases hs : step3 s a with
        | win => rw [hs] at hok; simp at hok
        | st s' n =>
          rw [hs] at hok
          simp only [Bool.and_eq_true, decide_eq_true_eq] at hok
          exact ih s' (nu u a n) hok.2.1 (Nat.le_trans hok.2.2 (nu_mono _ _ a n hg))

theorem g_start : g start3 = 0 := by decide
theorem valid_start3 : valid3 start3 = true := by decide

/- RETIRED (attempt 4): `l4_unwinnable_with_refill` and `witness3_wins_cap19` (grow right-first and
   refill min 7 refuted by attempt 4).
   RETIRED (attempt 5): `l4_no_win_cap17 : runB 17 start3 0 as = false` -- its certificate is replaced by the
   attempt-5 one below; the question it answered (is there slack?) is subsumed by `l4_unwinnable_half`. -/

/-- The attempt-4 plan. Counter after each step: L L L [3] D D [5] shrink [10] D [11] grow -> pickup [6]
    R R [8] U [9] fire [13] R x6 [14..19]; the last move STARTS at 18. -/
def plan4 : List Act :=
  [.move .left, .move .left, .move .left, .move .down, .move .down, .resize 0, .move .down, .resize 3,
   .move .right, .move .right, .move .up, .fire,
   .move .right, .move .right, .move .right, .move .right, .move .right, .move .right]

/-- MAIN (attempt 5): with the attempt-5 budget rule (cap 18; a 4x4 move starting at 18 only half-steps),
    no list of model actions wins level 4. -/
theorem l4_unwinnable_half (as : List Act) : runB5 18 start3 0 as = false :=
  no_win_from as start3 0 valid_start3 (by rw [g_start]; exact Nat.le_refl 0)

/-- Non-vacuity 1: one more unit (cap 19) and the attempt-4 plan wins under the attempt-5 rule. -/
theorem plan4_wins_cap19 : runB5 19 start3 0 plan4 = true := by decide

/-- Non-vacuity 2: the half-step rule is what blocks: under the attempt-4 rule (full last move) plan4 wins
    at cap 18 (`l4_winnable`), but under the attempt-5 rule it does not. -/
theorem plan4_fails_cap18 : runB5 18 start3 0 plan4 = false := by decide

/-- MAIN (attempt 4): in the amended model, with cap 18 (an action may START while at most 18 units are
    used, and its result counts), plan4 wins level 4. -/
/-  (kept) attempt-4 budget rule -/
theorem l4_winnable : runB 18 start3 0 plan4 = true := by decide

/-- The pickup rule is live: a 2x2 stepping onto the marker picks it up (attempt-3 observation). -/
theorem pickup_happens :
    step3 { start3 with i := 16, j := 12, big := false, face := .down } (.move .left) =
      .st { start3 with i := 16, j := 11, big := false, face := .left, picked := true } true := by decide

/-- ... and a 4x4 covering it with its front half elsewhere does not (attempt-1 observation). -/
theorem big_cover_no_pickup :
    step3 { start3 with i := 16, j := 12, face := .left } (.move .left) =
      .st { start3 with i := 16, j := 10, face := .left } false := by decide

end L4

