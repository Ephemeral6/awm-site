/-
# L5Grid — level 5 on a 2-pixel grid, with the move bar (attempt-2 amendment of the formal system)

Cell (i, j) = pixel rows 2i+1..2i+2, cols 2j+1..2j+2 (the agent's top-left corner is always at odd
pixel coordinates, so every agent covers whole cells). Map masks come from the L5 start frame
(lean/L5GridData.lean, generated by work/gen_l5grid.py).

State slots: position, size, 12-barrier gone, 13-barrier gone, 14 refill eaten, 15 frame present,
facing. Actions are coded 0..11 (0-3 = up/down/left/right, 4 = shrink, 5-8 = grow with one of four
placements, 9 = fire at the 12-box, 10 = fire at the 13-box, 11 = teleport); any other code is a
no-op costing nothing. (Attempt 6: clicks in the gaps between panel cells are NOT off-panel — they
toggle the neighbouring cell, i.e. they are panel clicks, covered by the atomic-completion bound.)
Attempt 3 established this for every click off the panel (free, 13-frame
error blink, board unchanged) and found ACTION5/7 rejected by the service; panel clicks that do not
complete a pattern only add cost, so dropping them is a lower bound (completions are atomic).

Rules (each mirrors a grid-layer concept; PERMISSIVE where the game was not pinned down):
  move      move_dir + blocked v4 (slide 1 cell for a big agent) + facing; eats the 14 item (-8.1 units net)
  shrink    shrink_f: keeps top-left, creates the 15 frame
  grow      grow_f: PERMISSIVE — any of the four 4x4 placements containing the 2x2 that fit; the
            established placement (grow_fit, attempt 9) is `growFit`, one of them
  fire      switch_6: PERMISSIVE — any lane across the agent's width, in the FACING direction only
  teleport  teleport_b: 15 frame present → 15 item (18,7); otherwise → pad (8,16)
  win       goal_reach: a move whose full-step target overlaps the goal box
Bar (attempt 9, concept bar_ticks, unique integer fit on 8 L5 runs): every action 1 tick, the
  completing click of a pattern 2 ticks (shrink/grow 5, fire/teleport 4 as macros), the refill move
  -9 net; budget B = 35. Experiment X7 (attempt 9): a non-winning action that would bring the count
  above 35 ends the game, whatever its cost; winning moves always go through.
  (Attempts 1-8 used fitted fractional costs; that version gave f start = 3229 hundredths vs cap 3200.)
-/
import L5GridData

namespace L5G

structure S where
  i : Nat
  j : Nat
  big : Bool
  cg : Bool
  dg : Bool
  ee : Bool
  fr : Bool
  fc : Nat
  deriving DecidableEq, Repr

def bit (m k : Nat) : Bool := (m >>> k) % 2 == 1

def walk (cg dg : Bool) (i j : Nat) : Bool :=
  decide (i < 23) && decide (j < 31) &&
    (bit W0 (i*31+j) || (cg && bit WC (i*31+j)) || (dg && bit WD (i*31+j)))

def fits (cg dg : Bool) (i j : Nat) (big : Bool) : Bool :=
  if big then walk cg dg i j && walk cg dg i (j+1) && walk cg dg (i+1) j && walk cg dg (i+1) (j+1)
  else walk cg dg i j

def sz (s : S) : Nat := if s.big then 2 else 1

def tgt (s : S) (d n : Nat) : Option (Nat × Nat) :=
  if d = 0 then (if s.i ≥ n then some (s.i - n, s.j) else none)
  else if d = 1 then some (s.i + n, s.j)
  else if d = 2 then (if s.j ≥ n then some (s.i, s.j - n) else none)
  else some (s.i, s.j + n)

def goalHit (ti tj n : Nat) : Bool :=
  decide (2*ti+1 ≤ 4) && decide (2*tj+2*n ≥ 32) && decide (2*tj+1 ≤ 37)

def wins (s : S) (a : Nat) : Bool :=
  if a < 4 then
    match tgt s a (sz s) with
    | some (ti, tj) => goalHit ti tj (sz s)
    | none => false
  else false

def winReady (s : S) : Bool := wins s 0 || wins s 1 || wins s 2 || wins s 3

def covers (i j : Nat) (big : Bool) (a b : Nat) : Bool :=
  let n := if big then 2 else 1
  decide (i ≤ a) && decide (a < i+n) && decide (j ≤ b) && decide (b < j+n)

/-- cost of one move in ticks (attempt 9: integer tick model `bar_ticks`, unique fit on 8 L5 runs) -/
def mc (_s : S) : Int := 1

def place (s : S) (i j d : Nat) : S × Int :=
  if !s.ee && covers i j s.big 18 24 then ({ s with i := i, j := j, ee := true, fc := d }, mc s - 10)
  else ({ s with i := i, j := j, fc := d }, mc s)

def move (s : S) (d : Nat) : S × Int :=
  match tgt s d (sz s) with
  | none => ({ s with fc := d }, mc s)
  | some (ti, tj) =>
    if fits s.cg s.dg ti tj s.big then place s ti tj d
    else if s.big then
      match tgt s d 1 with
      | some (hi, hj) => if fits s.cg s.dg hi hj true then place s hi hj d else ({ s with fc := d }, mc s)
      | none => ({ s with fc := d }, mc s)
    else ({ s with fc := d }, mc s)

def rayHit (cg dg : Bool) (box : Nat) : Nat → Nat → Nat → Nat → Bool
  | 0, _, _, _ => false
  | fuel+1, i, j, d =>
    if walk cg dg i j then
      if d = 0 then (if i = 0 then false else rayHit cg dg box fuel (i-1) j d)
      else if d = 1 then rayHit cg dg box fuel (i+1) j d
      else if d = 2 then (if j = 0 then false else rayHit cg dg box fuel i (j-1) d)
      else rayHit cg dg box fuel i (j+1) d
    else decide (i < 23) && decide (j < 31) && bit box (i*31+j)

def laneK (s : S) (box k : Nat) : Bool :=
  if s.fc = 0 then decide (s.i ≥ 1) && rayHit s.cg s.dg box 40 (s.i-1) (s.j+k) 0
  else if s.fc = 1 then rayHit s.cg s.dg box 40 (s.i + sz s) (s.j+k) 1
  else if s.fc = 2 then decide (s.j ≥ 1) && rayHit s.cg s.dg box 40 (s.i+k) (s.j-1) 2
  else rayHit s.cg s.dg box 40 (s.i+k) (s.j + sz s) 3

def laneHit (s : S) (box : Nat) : Bool := laneK s box 0 || (s.big && laneK s box 1)

def step (s : S) (a : Nat) : S × Int :=
  if a < 4 then move s a
  else if a = 4 then (if s.big then ({ s with big := false, fr := true }, 5) else (s, 5))
  else if a ≤ 8 then
    let di := if a = 7 ∨ a = 8 then 1 else 0
    let dj := if a = 6 ∨ a = 8 then 1 else 0
    if s.big then (s, 5)
    else if decide (s.i ≥ di) && decide (s.j ≥ dj) && fits s.cg s.dg (s.i-di) (s.j-dj) true then
      ({ s with i := s.i-di, j := s.j-dj, big := true, fr := false }, 5)
    else (s, 5)
  else if a = 9 then (if !s.cg && laneHit s BC then ({ s with cg := true }, 4) else (s, 4))
  else if a = 10 then (if !s.dg && laneHit s BD then ({ s with dg := true }, 4) else (s, 4))
  else if a = 11 then (if s.fr then ({ s with i := 18, j := 7 }, 4) else ({ s with i := 8, j := 16 }, 4))
  else (s, 0)

/-- grow_fit (attempt 9; replaces the facing-based grow_place, retired): a small agent grows into the
    first placement that fits, trying cell offsets (-1,-1), (0,-1), (-1,0), (0,0) = codes 8, 6, 7, 5. -/
def growFit (s : S) : S × Int :=
  if (step s 8).1.big = true ∧ s.big = false then step s 8
  else if (step s 6).1.big = true ∧ s.big = false then step s 6
  else if (step s 7).1.big = true ∧ s.big = false then step s 7
  else step s 5

/-- attempt 2: 2x2 at pixel (15,45) facing up -> 4x4 at pixel (15,43) -/
theorem growFit_obs_up :
    (growFit ⟨7, 22, false, true, false, true, true, 0⟩).1 = ⟨7, 21, true, true, false, true, false, 0⟩ := by decide

/-- attempt 3: 2x2 at pixel (17,47) facing right -> 4x4 at pixel (15,45) -/
theorem growFit_obs_right :
    (growFit ⟨8, 23, false, true, false, true, true, 3⟩).1 = ⟨7, 22, true, true, false, true, false, 3⟩ := by decide

/-- attempt 9: 2x2 at pixel (37,15) facing down -> 4x4 at pixel (35,13) -/
theorem growFit_obs_down :
    (growFit ⟨18, 7, false, false, false, false, true, 1⟩).1 = ⟨17, 6, true, false, false, false, false, 1⟩ := by decide

/-- attempt 9: 2x2 at pixel (37,13) facing left -> 4x4 at pixel (35,13) -/
theorem growFit_obs_left :
    (growFit ⟨18, 6, false, false, false, false, true, 2⟩).1 = ⟨17, 6, true, false, false, false, false, 2⟩ := by decide

/-- attempt 5: 2x2 at pixel (13,21) in the 2-wide stem: no placement fits, nothing changes -/
theorem growFit_obs_stem :
    (growFit ⟨6, 10, false, false, false, false, true, 0⟩).1 = ⟨6, 10, false, false, false, false, true, 0⟩ := by decide

/-- the game under the bar rule (attempt 9, experiment X7): a winning move always goes through;
    any other action ends the game if it would bring the tick count above `cap` -/
def playB (cap : Int) : S → Int → List Nat → Bool
  | _, _, [] => false
  | s, r, a :: as => if wins s a then true
                     else if r + (step s a).2 ≤ cap then playB cap (step s a).1 (r + (step s a).2) as else false

def play := playB 35

def start : S := ⟨14, 8, true, false, false, false, false, 1⟩

/-! ## certificate: a cost-to-go table checked against `step` -/

def code (s : S) : Nat :=
  s.i*3968 + s.j*128 + s.fc*32 + (if s.big then 16 else 0) + (if s.cg then 8 else 0) +
  (if s.dg then 4 else 0) + (if s.ee then 2 else 0) + (if s.fr then 1 else 0)

def decode (k : Nat) : S :=
  ⟨k / 3968, (k / 128) % 31, (k/16)%2 == 1, (k/8)%2 == 1, (k/4)%2 == 1, (k/2)%2 == 1, k%2 == 1, (k/32)%4⟩

def raw (s : S) : Nat := (ftab (code s / 3968) >>> (12 * (code s % 3968))) % 4096

def f (s : S) : Int := if raw s = 0 then -1000000 else (raw s : Int) - 2000

def validB (s : S) : Bool := decide (s.i < 23) && decide (s.j < 31) && decide (s.fc < 4)

def actOk (s : S) (a : Nat) : Bool :=
  wins s a ||
    (decide (f s ≤ (step s a).2 + f (step s a).1) && validB (step s a).1)

def okS (s : S) : Bool :=
  raw s == 0 ||
    ((!winReady s || decide (f s ≤ 0)) &&
     actOk s 0 && actOk s 1 && actOk s 2 && actOk s 3 && actOk s 4 && actOk s 5 &&
     actOk s 6 && actOk s 7 && actOk s 8 && actOk s 9 && actOk s 10 && actOk s 11)

def checkRange : Nat → Nat → Bool
  | _, 0 => true
  | lo, n+1 => okS (decode lo) && checkRange (lo+1) n

theorem checkRange_sound : ∀ n lo, checkRange lo n = true → ∀ k, lo ≤ k → k < lo + n → okS (decode k) = true := by
  intro n
  induction n with
  | zero => intro lo _ k h1 h2; omega
  | succ n ih =>
    intro lo h k h1 h2
    simp only [checkRange, Bool.and_eq_true] at h
    by_cases hk : k = lo
    · subst hk; exact h.1
    · exact ih (lo+1) h.2 k (by omega) (by omega)

