  intro k hk
  rcases Nat.lt_or_ge k 3968 with h0 | h0
  · exact checkRange_sound _ _ row0 k (by omega) (by omega)
  rcases Nat.lt_or_ge k 7936 with h1 | h1
  · exact checkRange_sound _ _ row1 k (by omega) (by omega)
  rcases Nat.lt_or_ge k 11904 with h2 | h2
  · exact checkRange_sound _ _ row2 k (by omega) (by omega)
  rcases Nat.lt_or_ge k 15872 with h3 | h3
  · exact checkRange_sound _ _ row3 k (by omega) (by omega)
  rcases Nat.lt_or_ge k 19840 with h4 | h4
  · exact checkRange_sound _ _ row4 k (by omega) (by omega)
  rcases Nat.lt_or_ge k 23808 with h5 | h5
  · exact checkRange_sound _ _ row5 k (by omega) (by omega)
  rcases Nat.lt_or_ge k 27776 with h6 | h6
  · exact checkRange_sound _ _ row6 k (by omega) (by omega)
  rcases Nat.lt_or_ge k 31744 with h7 | h7
  · exact checkRange_sound _ _ row7 k (by omega) (by omega)
  rcases Nat.lt_or_ge k 35712 with h8 | h8
