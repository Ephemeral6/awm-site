def Φ (k : Nat) : Int := (look k).getD 0

def okAt (k : Nat) : Bool :=
  acts.all (fun a =>
    match mstep k a with
    | (.won, w) => decide (Φ k ≤ w)
    | (.st y, w) => decide (y < N) && (look y).isSome && decide (Φ k ≤ Φ y + w))

/-- **The certificate**, checked by the kernel. -/
theorem cert : (List.range N).all (fun k => (look k).isNone || okAt k) = true := by decide +kernel

def mwins : Nat → List MAct → Bool
  | _, [] => false
  | k, a :: as => match (mstep k a).1 with
    | .won => true
    | .st y => mwins y as

/-- Budget spent up to and including the winning step. -/
def mcost : Nat → List MAct → Int
  | _, [] => 0
  | k, a :: as => (mstep k a).2 + (match (mstep k a).1 with
    | .won => 0
    | .st y => mcost y as)

theorem okAt_of (k : Nat) (hk : k < N) (hs : (look k).isSome = true) : okAt k = true := by
  have h := (List.all_eq_true.mp cert) k (List.mem_range.mpr hk)
  cases hl : (look k) with
  | none => rw [hl] at hs; simp at hs
  | some v => rw [hl] at h; simpa using h

theorem phi_le_cost : ∀ (as : List MAct) (k : Nat), k < N → (look k).isSome = true →
    mwins k as = true → Φ k ≤ mcost k as := by
  intro as
  induction as with
  | nil => intro k _ _ h; simp [mwins] at h
  | cons a as ih =>
    intro k hk hs hw
    have hok := okAt_of k hk hs
    have ha : a ∈ acts := by cases a <;> (try rename_i d; cases d) <;> simp [acts]
    have hka := (List.all_eq_true.mp hok) a ha
    rcases hm : mstep k a with ⟨res, w⟩
    rw [hm] at hka
    cases res with
    | won =>
      have h1 : Φ k ≤ w := by simpa using hka
      simp only [mcost, hm]
      omega
    | st y =>
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hka
      obtain ⟨⟨hy, hys⟩, hle⟩ := hka
      have hw' : mwins y as = true := by simpa [mwins, hm] using hw
      have := ih y hy hys hw'
      simp only [mcost, hm]
      omega

def init : Nat := mk 25 37 4 false true
theorem phi_init : Φ init = 20 := by decide +kernel
theorem init_ok : init < N ∧ (look init).isSome = true := by decide +kernel

/-- Measured budget of level 4 (in units). -/
def Bud : Int := 18

/-- **Main theorem.** In the macro abstraction, every winning action sequence from the level
    start spends at least Φ init = 20 units, so none fits in `Bud`. -/
theorem no_win_within_budget : ∀ as : List MAct, mwins init as = true → Bud < mcost init as := by
  intro as h
  have := phi_le_cost as init init_ok.1 init_ok.2 h
  rw [phi_init] at this
  simp [Bud]
  omega

/-- **Main theorem (attempt-8 amendment).** The over-budget action is still executed (observed
    in all 8 GAME_OVER steps). So, conservatively, allow a win on that one extra step: a win
    whose final step is the over-step spends at most `Bud + 1` (each step costs ≤ 2 and the
    previous total was ≤ Bud; a 1-unit move is the only winning step). Every win spends
    ≥ Φ init, which exceeds `Bud + 1`. -/
theorem no_win_even_with_overstep : ∀ as : List MAct, mwins init as = true → Bud + 1 < mcost init as := by
  intro as h
  have := phi_le_cost as init init_ok.1 init_ok.2 h
  rw [phi_init] at this
  simp [Bud]
  omega

#print axioms cert
#print axioms phi_le_cost
#print axioms no_win_within_budget
#print axioms no_win_even_with_overstep

end Level4Cert
