/-!
# Level 4: impossibility certificate (attempt 4 rule set). Generated by work/gen_cert.py.

**Macro abstraction** of `Level4.stepC`. A state is a Nat key encoding (r, c, side, dGone, item).
* Facing is dropped, so FIRE is allowed in any facing (looser).
* Clicks are merged into macros at their minimum cost: SIZE (shrink or grow) = 4 clicks + 1 = 5;
  FIRE = 3 clicks + 1 = 4.
* Weight-0 actions that change nothing (HINT icon clicks, attempt 5; no-change actions, cost 0 by
  the fit) satisfy Φ k ≤ Φ k + 0 trivially, so they are omitted from cts.
* REFILL is refund 10: weight 1 - 10 = -9 on the pickup move. The real refund is truncated at 0
  (`used - 10` in Nat), so the real budget used is ≥ the sum of weights.
* Moves, passability, exit and grow anchor are as in `Level4.lean`.
* `phiTab` is a table of exact minimum costs to win, computed outside Lean. **Lean checks it**:
  `cert` verifies `Φ k ≤ Φ k' + w` on every edge of every tabled state, closure under steps,
  and `Φ k ≤ w` on winning moves. So the table is a certificate, not a trusted input.
-/
namespace Level4Cert

def le (a b : Nat) : Bool := decide (a ≤ b)
def inR (lo x hi : Nat) : Bool := le lo x && le x hi
def room (r c : Nat) : Bool := inR 21 r 36 && inR 21 c 44
def stem (r c : Nat) : Bool := inR 9 r 20 && inR 31 c 32
def corr (r c : Nat) : Bool := inR 29 r 32 && inR 45 c 56
def passable (dg : Bool) (r c : Nat) : Bool :=
  room r c || stem r c || (corr r c && (dg || le 48 c)) || (dg && inR 5 r 8 && inR 30 c 33)
def exitCell (r c : Nat) : Bool := inR 28 r 33 && inR 57 c 62
def itemHit (r c : Nat) : Bool := inR 33 r 35 && inR 22 c 24
def fits4 (dg : Bool) (r c : Nat) : Bool :=
  (List.range 4).all (fun a => (List.range 4).all (fun b => passable dg (r + a) (c + b)))

/-- key layout -/
def kr (k : Nat) : Nat := k / 512
def kc (k : Nat) : Nat := (k / 8) % 64
def ks (k : Nat) : Nat := if (k / 4) % 2 = 1 then 4 else 2
def kd (k : Nat) : Bool := (k / 2) % 2 == 1
def ki (k : Nat) : Bool := k % 2 == 1
def mk (r c s : Nat) (dg it : Bool) : Nat :=
  ((r * 64 + c) * 2 + (if s = 4 then 1 else 0)) * 4 + (if dg then 2 else 0) + (if it then 1 else 0)
def N : Nat := 32768

inductive Dir where | up | down | left | right
  deriving DecidableEq

def edge (r c s : Nat) (d : Dir) (n : Nat) : List (Nat × Nat) :=
  match d with
  | .up    => (List.range s).map (fun j => (r - n, c + j))
  | .down  => (List.range s).map (fun j => (r + s - 1 + n, c + j))
  | .left  => (List.range s).map (fun i => (r + i, c - n))
  | .right => (List.range s).map (fun i => (r + i, c + s - 1 + n))

def advance (dg : Bool) (r c s : Nat) (d : Dir) : Nat → Nat → Nat × Bool
  | 0, k => (k, false)
  | fuel + 1, k =>
    if le s k then (k, false) else
    let e := edge r c s d (k + 1)
    if e.all (fun p => passable dg p.1 p.2) then advance dg r c s d fuel (k + 1)
    else (k, e.any (fun p => exitCell p.1 p.2))

inductive MAct where
  | mv (d : Dir)
  | size     -- shrink (4x4) or grow (2x2, bottom-right kept) : 4 clicks + extra
  | fire     -- 6 column : 3 clicks + extra
  deriving DecidableEq

inductive Res where
  | won
  | st (k : Nat)

/-- One macro step: result and weight (budget units). -/
def mstep (k : Nat) : MAct → Res × Int
  | .mv d =>
    let r := kr k; let c := kc k; let s := ks k; let dg := kd k; let it := ki k
    let (n, hit) := advance dg r c s d 4 0
    if hit then (.won, 1) else
    let (nr, nc) : Nat × Nat := match d with
      | .up => (r - n, c) | .down => (r + n, c) | .left => (r, c - n) | .right => (r, c + n)
    if it && s == 2 && itemHit nr nc then (.st (mk nr nc s dg false), -9)
    else (.st (mk nr nc s dg it), 1)
  | .size =>
    let r := kr k; let c := kc k; let dg := kd k; let it := ki k
    if ks k == 4 then (.st (mk r c 2 dg it), 5)
    else if fits4 dg (r - 2) (c - 2) then (.st (mk (r - 2) (c - 2) 4 dg it), 5)
    else (.st k, 5)
  | .fire =>
    let r := kr k; let c := kc k
    (.st (mk r c (ks k) (kd k || (inR 31 c 32 && inR 9 r 36)) (ki k)), 4)

def acts : List MAct := [.mv .up, .mv .down, .mv .left, .mv .right, .size, .fire]

